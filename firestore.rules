rules_version = '2';

// PennyWise security rules.
//
// Data layout (everything a user owns lives under their own uid):
//   users/{uid}                      profile: email, name, photo, timestamps
//   users/{uid}/transactions/{id}    money movements of seven types (manual, or
//                                    detected from an SMS; detected ones use
//                                    "<source>_<code>" as the id, which is
//                                    what prevents duplicates)
//   users/{uid}/budgets/{YYYY-MM}    overall spending limit per month
//   users/{uid}/categoryRules/{key}  categories learned from the user's own
//                                    corrections ("OUT:NAIVAS" -> shopping)
//   users/{uid}/accounts/{id}        the user's own accounts (SIM 1 / SIM 2
//                                    M-Pesa, their Ziidi and Fuliza, banks,
//                                    cash)
//
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Server timestamps written by FieldValue.serverTimestamp() equal
    // request.time, so clients can't backdate or forge them.
    function stampedNow(field) {
      return request.resource.data[field] == request.time;
    }

    function createdAtUnchanged() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    // ---- users/{uid} -----------------------------------------------------

    function isValidProfile(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt'])
        // hasOnly() is what keeps passwords (or anything else) out.
        && data.keys().hasOnly(
            ['email', 'displayName', 'photoUrl', 'createdAt', 'updatedAt'])
        && data.email == request.auth.token.email
        && (!('displayName' in data)
            || data.displayName == null
            || (data.displayName is string && data.displayName.size() <= 100))
        // Google profile picture; null for email/password accounts.
        && (!('photoUrl' in data)
            || data.photoUrl == null
            || (data.photoUrl is string
                && data.photoUrl.size() <= 2048
                && data.photoUrl.matches('^https://.+')))
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidProfile(request.resource.data)
        && stampedNow('createdAt') && stampedNow('updatedAt');
      allow update: if isOwner(userId)
        && isValidProfile(request.resource.data)
        && createdAtUnchanged() && stampedNow('updatedAt');

      // ---- users/{uid}/transactions/{transactionId} ----------------------

      // Accounts a transaction can name ("savings" is only reached through
      // the savings types, so it is never a from/to account).
      function isSpendableAccount(value) {
        return value in ['mpesa', 'airtel_money', 'cash', 'bank'];
      }

      // Ids of the user's own accounts, e.g. "mpesa-sim1", "equity-bank".
      function isAccountId(value) {
        return value is string && value.matches('^[a-z0-9-]{1,48}$');
      }

      function isValidTransaction(data) {
        return data.keys().hasAll(
            ['amount', 'type', 'category', 'description', 'date',
             'createdAt', 'updatedAt'])
          && data.keys().hasOnly(
            ['amount', 'type', 'category', 'description', 'note', 'date',
             'source', 'reference', 'smsText', 'account', 'toAccount', 'fee',
             'interest', 'refundOf', 'categoryStatus', 'channel',
             'reclassifiedFrom', 'accountId', 'toAccountId', 'simSlot',
             'createdAt', 'updatedAt'])
          && data.amount is number
          && data.amount > 0 && data.amount < 1000000000
          // "income" and "expense" are what every older document holds.
          && data.type in ['income', 'expense', 'transfer',
                           'savings_contribution', 'savings_withdrawal',
                           'refund', 'debt_repayment']
          // All optional, so older documents stay valid.
          && (!('account' in data) || isSpendableAccount(data.account))
          // The user's own account ids (Stage 3); optional.
          && (!('accountId' in data) || isAccountId(data.accountId))
          && (!('toAccountId' in data) || isAccountId(data.toAccountId))
          && (!('simSlot' in data)
              || (data.simSlot is int && data.simSlot >= 0
                  && data.simSlot <= 3))
          // Two account ids on one transaction are never the same account.
          && (!('accountId' in data && 'toAccountId' in data)
              || data.toAccountId != data.accountId)
          // A transfer names both sides. With account ids (needed for
          // SIM 1 -> SIM 2, where both are "M-Pesa") both ids are required;
          // without them, both older generic accounts (M-Pesa, Cash...) are.
          // Any generic toAccount given must be spendable and differ from
          // the generic account, so the two pairs can't contradict.
          && (data.type == 'transfer'
              ? (('accountId' in data || 'toAccountId' in data
                  ? ('accountId' in data && 'toAccountId' in data)
                  : ('account' in data && 'toAccount' in data))
                 && (!('toAccount' in data)
                     || (isSpendableAccount(data.toAccount)
                         && data.toAccount != data.get('account', null))))
              : !('toAccount' in data))
          // The other-side account id only exists where there is another
          // side: transfers, savings and debt repayments.
          && (!('toAccountId' in data)
              || data.type in ['transfer', 'savings_contribution',
                               'savings_withdrawal', 'debt_repayment'])
          // Provider charge on top of the amount.
          && (!('fee' in data)
              || (data.fee is number && data.fee > 0
                  && data.fee < 1000000000))
          // Interest is part of a debt repayment, never more than it.
          && (!('interest' in data)
              || (data.type == 'debt_repayment' && data.interest is number
                  && data.interest >= 0 && data.interest <= data.amount))
          // Optional link from a refund to the purchase it refunds.
          && (!('refundOf' in data)
              || (data.type == 'refund' && data.refundOf is string
                  && data.refundOf.size() > 0
                  && data.refundOf.size() <= 128))
          && data.category is string
          && data.category.size() > 0 && data.category.size() <= 40
          && data.description is string
          && data.description.size() > 0 && data.description.size() <= 100
          && (!('note' in data)
              || (data.note is string && data.note.size() <= 500))
          // Set only on transactions detected from an M-Pesa / Airtel Money
          // SMS (Android). Manual entries don't have them.
          && (!('source' in data) || data.source in ['mpesa', 'airtel'])
          && (!('reference' in data)
              || (data.reference is string
                  && data.reference.size() > 0
                  && data.reference.size() <= 40))
          && (!('smsText' in data)
              || (data.smsText is string && data.smsText.size() <= 1000))
          // Phase 3: how sure the automatic category is (missing = confirmed)
          // and how the money moved, from the SMS.
          && (!('categoryStatus' in data)
              || data.categoryStatus in ['suggested', 'review'])
          && (!('channel' in data)
              || data.channel in ['till', 'paybill', 'send', 'agent',
                                  'airtime', 'received'])
          // Undo marker left by the opt-in history fix: what the record was
          // before. Only on SMS imports, and only these three keys.
          && (!('reclassifiedFrom' in data)
              || ('source' in data && 'reference' in data
                  && data.reclassifiedFrom is map
                  && data.reclassifiedFrom.keys().hasAll(
                      ['type', 'category', 'at'])
                  && data.reclassifiedFrom.keys().hasOnly(
                      ['type', 'category', 'at'])
                  && data.reclassifiedFrom.type in ['income', 'expense']
                  && data.reclassifiedFrom.category is string
                  && data.reclassifiedFrom.category.size() > 0
                  && data.reclassifiedFrom.category.size() <= 40
                  && data.reclassifiedFrom.at is timestamp))
          && data.date is timestamp
          && data.createdAt is timestamp;
      }

      // The undo marker can't be created with a document, and when it is
      // added or changed its time must be now (so it equals updatedAt; a
      // later edit by the user then shows as updatedAt > at).
      function reclassificationOk() {
        return !('reclassifiedFrom' in request.resource.data)
          || (('reclassifiedFrom' in resource.data)
              && request.resource.data.reclassifiedFrom
                   == resource.data.reclassifiedFrom)
          || request.resource.data.reclassifiedFrom.at == request.time;
      }

      match /transactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidTransaction(request.resource.data)
          && !('reclassifiedFrom' in request.resource.data)
          && stampedNow('createdAt') && stampedNow('updatedAt');
        allow update: if isOwner(userId)
          && isValidTransaction(request.resource.data)
          && reclassificationOk()
          && createdAtUnchanged() && stampedNow('updatedAt');
      }

      // ---- users/{uid}/categoryRules/{ruleId} ----------------------------

      function isValidRule(data, ruleId) {
        return data.keys().hasAll(
            ['merchantKey', 'categoryId', 'type', 'count', 'createdAt',
             'updatedAt'])
          && data.keys().hasOnly(
            ['merchantKey', 'categoryId', 'type', 'count', 'label',
             'createdAt', 'updatedAt'])
          // The id is the merchant key, e.g. "OUT:NAIVAS".
          && ruleId.matches('^[A-Z0-9_:-]{1,120}$')
          && data.merchantKey == ruleId
          && data.categoryId is string
          && data.categoryId.size() > 0 && data.categoryId.size() <= 40
          && data.type in ['income', 'expense', 'transfer',
                           'savings_contribution', 'savings_withdrawal',
                           'refund', 'debt_repayment']
          && data.count is int && data.count >= 1 && data.count <= 100000
          && (!('label' in data)
              || (data.label is string && data.label.size() <= 100))
          && data.createdAt is timestamp;
      }

      match /categoryRules/{ruleId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidRule(request.resource.data, ruleId)
          && stampedNow('createdAt') && stampedNow('updatedAt');
        allow update: if isOwner(userId)
          && isValidRule(request.resource.data, ruleId)
          && createdAtUnchanged() && stampedNow('updatedAt');
      }

      // ---- users/{uid}/accounts/{accountId} ------------------------------

      function isValidAccount(data, accountId) {
        return data.keys().hasAll(
            ['name', 'kind', 'provider', 'active', 'order', 'createdAt',
             'updatedAt'])
          && data.keys().hasOnly(
            ['name', 'kind', 'provider', 'simSlot', 'parentId',
             'openingBalance', 'openingDate', 'active', 'order', 'createdAt',
             'updatedAt'])
          && accountId.matches('^[a-z0-9-]{1,48}$')
          && data.name is string
          && data.name.size() > 0 && data.name.size() <= 40
          && data.kind in ['mobile_money', 'bank', 'cash', 'savings', 'loan']
          && data.provider in ['safaricom', 'airtel', 'equity', 'other_bank',
                               'none']
          && (!('simSlot' in data)
              || (data.simSlot is int && data.simSlot >= 0
                  && data.simSlot <= 3))
          && (!('parentId' in data) || isAccountId(data.parentId))
          && (!('openingBalance' in data)
              || (data.openingBalance is number
                  && data.openingBalance > -1000000000
                  && data.openingBalance < 1000000000))
          && (!('openingDate' in data) || data.openingDate is timestamp)
          && data.active is bool
          && data.order is int && data.order >= 0 && data.order <= 10000
          && data.createdAt is timestamp;
      }

      match /accounts/{accountId} {
        // No delete: hiding an account (active = false) keeps every
        // transaction that points at it meaningful.
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidAccount(request.resource.data, accountId)
          && stampedNow('createdAt') && stampedNow('updatedAt');
        allow update: if isOwner(userId)
          && isValidAccount(request.resource.data, accountId)
          && createdAtUnchanged() && stampedNow('updatedAt');
      }

      // ---- users/{uid}/budgets/{monthId} ---------------------------------

      function isValidBudget(data, monthId) {
        return data.keys().hasAll(['month', 'limit', 'updatedAt'])
          && data.keys().hasOnly(['month', 'limit', 'updatedAt'])
          // The document id is the month ("YYYY-MM"), so there's one budget
          // per month.
          && monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && data.month == monthId
          && data.limit is number
          && data.limit > 0 && data.limit < 1000000000;
      }

      match /budgets/{monthId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidBudget(request.resource.data, monthId)
          && stampedNow('updatedAt');
      }
    }
  }
}
